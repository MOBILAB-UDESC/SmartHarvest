<root BTCPP_format="4">

  <BehaviorTree ID="MainTree">
    <RetryUntilSuccessful num_attempts="5">
      <Sequence name="MainSequence">

        <!-- Try to detect objects from one of two cameras -->
        <Fallback name="PredictionFallback">
          <!-- camera_default_topics are defined in the yaml config -->
          <SubTree ID="DetectionTree" name="JackalCamera"
            topic_names="{camera_default_topics}"
            service_name="{detection_service_name}"
            _autoremap="true" />
          <SubTree ID="DetectionTree"
            topic_names="camera_1/rgb/image;camera_1/depth/image;camera_1/rgb/camera_info"
            service_name="{detection_service_name}"
            _autoremap="true" />
        </Fallback>

      </Sequence>
    </RetryUntilSuccessful>
  </BehaviorTree>

  <BehaviorTree ID="DetectionTree">
    <Sequence name="DetectionSequence">
      <GetCameraDataAction
        topic_names="{topic_names}"
        rgb_image="{rgb}" depth_image="{depth}" cam_info="{info}" />
      <PredictAction
        service_name="{service_name}" rgb_image="{rgb}" depth_image="{depth}" cam_info="{info}"
        objects="{objects}" />
