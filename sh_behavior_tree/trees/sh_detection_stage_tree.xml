<root BTCPP_format="4">

  <BehaviorTree ID="MainTree">
    <RetryUntilSuccessful num_attempts="1">
      <Sequence name="MainSequence">
<!--
        <MoveArmToNamedTargetAction
          action_name="move_to_named_target" group_name="arm" named_target="hook"
          error_code="{error_code}" /> -->

        <!-- Try to detect objects from one of two cameras -->
        <Fallback name="PredictionFallback">
          <!-- camera_default_topics are defined in the yaml config -->
          <SubTree ID="DetectionTree" name="JackalCamera"
            topic_names="{camera_default_topics}"
            service_name="{detection_service_name}"
            _autoremap="true" />
          <SubTree ID="DetectionTree"
            topic_names="arm_camera_1/rgb/image;arm_camera_1/depth/image;arm_camera_1/rgb/camera_info"
            service_name="{detection_service_name}"
            _autoremap="true" />
        </Fallback>

        <!-- Transform objects poses into a static frame -->
        <TransformPoseAction name="transform_pose_action"
          transform_frame="base_link" objects="{objects}"
          transformed_objects="{objects}" />
        <ClearPlanningSceneAction service_name="clear_scene" />
        <UpdateSceneFromPosesAction service_name="update_from_pose_scene" objects="{objects}" />
        <MoveGripperAction
          action_name="move_to_named_target" group_name="gripper" named_target="open"
          error_code="{error_code}" />
        <Script code=" n_objects := total_objects " />
        <Script code=" index := 1 " />
        <Script code=" n_collected_objects := 0 " />

        <SubTree ID="MoveTree"
          _autoremap="true" />

      </Sequence>
    </RetryUntilSuccessful>
  </BehaviorTree>

  <BehaviorTree ID="DetectionTree">
    <Sequence name="DetectionSequence">
      <GetCameraDataAction
        topic_names="{topic_names}"
        rgb_image="{rgb}" depth_image="{depth}" cam_info="{info}" />
      <PredictAction
        service_name="{service_name}" rgb_image="{rgb}" depth_image="{depth}" cam_info="{info}"
        objects="{objects}" />
      <AreObjectsFoundCondition
        objects="{objects}"
        total_objects="{total_objects}" />
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="MoveTree">
    <RetryUntilSuccessful name="PickLoop" num_attempts="{total_objects}">

    <Sequence name="MoveSequence">
      <ForceSuccess>
        <Fallback name="PickFallback">
          <Sequence name="PickSequence">
            <GetCurrentObjectAction in_current_count="{index}" object_prefix="Apple"
              current_object_name="{object_name}" />
            <MoveArmToDetectedObjectAction
              action_name="move_to_object" group_name="arm" object_name="{object_name}"
              error_code="{error_code}" />
            <MoveGripperAction
              action_name="move_to_named_target" group_name="gripper" named_target="half-close"
              attach="1" detach="0" object_to_attach_detach="{object_name}" link_to_attach_detach="arm_gripper_base_link"
              error_code="{error_code}" />
            <MoveArmToNamedTargetAction
              action_name="move_to_named_target" group_name="arm" named_target="place"
              error_code="{error_code}" />
            <MoveGripperAction
              action_name="move_to_named_target" group_name="gripper" named_target="open"
              attach="0" detach="1" object_to_attach_detach="{object_name}"
              error_code="{error_code}" />
          </Sequence>
        </Fallback>
      </ForceSuccess>
      <ErrorCheckerAction error_id="{error_code}" in_current_count="{index}" total_objects="{total_objects}"
        out_next_count="{index}" collected_object="{n_collected_objects}"/>
    </Sequence>

    </RetryUntilSuccessful>
  </BehaviorTree>

</root>